{
  "name": "vibe-tent",
  "version": "0.2.1",
  "description": "A context graph for your project: what you decided, and what came of it.",
  "type": "module",
  "bin": {
    "tent": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "manifest.json",
    "skills/",
    "skill-resources/",
    "scripts/okf-check.mjs",
    "docs/upstream/okf-SPEC.md",
    "docs/upstream/okf-LICENSE.md",
    "docs/SPEC.md",
    "docs/PLUGIN.md",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "plugin:build": "node scripts/build-plugin.mjs",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --import tsx scripts/run-tests.ts full",
    "test:fast": "node --import tsx scripts/run-tests.ts fast",
    "test:integration": "node --import tsx scripts/run-tests.ts integration",
    "typecheck": "tsc -noEmit",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\" esbuild.config.mjs",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs}\" esbuild.config.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "okf:check": "node scripts/okf-check.mjs",
    "okf:check:links": "node scripts/okf-check.mjs --check-links",
    "okf:upstream": "node scripts/okf-upstream.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test && npm run okf:check",
    "prepack": "npm run check"
  },
  "keywords": [
    "agent",
    "coding-agents",
    "agent-plugin",
    "cli",
    "okf",
    "open-knowledge-format",
    "context-engineering"
  ],
  "license": "MIT",
  "author": "cucarol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucarol/tent.git"
  },
  "bugs": {
    "url": "https://github.com/cucarol/tent/issues"
  },
  "homepage": "https://github.com/cucarol/tent#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "prettier": "3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  }
}
