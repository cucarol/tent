{
  "name": "vibe-tent",
  "version": "0.1.1",
  "description": "A local Workspace context graph for durable Nodes, immutable Cards, optional Roles, and Agent plugin workflows.",
  "type": "module",
  "bin": {
    "tent": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "ui-dist/",
    "!ui-dist/snapshot.json",
    "!ui-dist/**/*.map",
    "manifest.json",
    "skills/",
    "skill-resources/",
    "scripts/okf-check.mjs",
    "docs/upstream/okf-SPEC.md",
    "docs/upstream/okf-LICENSE.md",
    "docs/SPEC.md",
    "docs/PLUGIN.md",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "plugin:build": "node scripts/build-plugin.mjs",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --import tsx scripts/run-tests.ts full",
    "test:fast": "node --import tsx scripts/run-tests.ts fast",
    "test:integration": "node --import tsx scripts/run-tests.ts integration",
    "typecheck": "tsc -noEmit",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx,mjs}\" esbuild.config.mjs",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,tsx,mjs}\" esbuild.config.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "okf:check": "node scripts/okf-check.mjs",
    "okf:check:links": "node scripts/okf-check.mjs --check-links",
    "okf:upstream": "node scripts/okf-upstream.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test && npm run okf:check",
    "prepack": "npm run check",
    "ui:build": "node scripts/ui-build.mjs",
    "ui:dev": "node --import tsx scripts/ui-dev.ts"
  },
  "keywords": [
    "agent",
    "coding-agents",
    "agent-plugin",
    "cli",
    "okf",
    "open-knowledge-format",
    "context-engineering"
  ],
  "license": "MIT",
  "author": "cucarol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucarol/tent.git"
  },
  "bugs": {
    "url": "https://github.com/cucarol/tent/issues"
  },
  "homepage": "https://github.com/cucarol/tent#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.48.0",
    "marked": "^15.0.12",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supports-color": "^8.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
