{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT,'hooks','session.mjs')).href)\" -- start",
            "timeout": 60,
            "statusMessage": "Locating Tent workspace"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT,'hooks','session.mjs')).href)\" -- tool",
            "timeout": 60
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|AskUserQuestion"
      }
    ]
  }
}
